    },
    "/api/metrics": {
      "get": {
        "tags": [
          "Service"
        ],
        "summary": "Диагностика запросов и времени ответа",
        "description": "Агрегированные показатели без персональных данных.",
        "responses": {
          "200": {
            "description": "Метрики",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string",
                      "example": "ok"
                    },
                    "uptime_seconds": {
                      "type": "number"
                    },
                    "requests": {
                      "type": "integer"
                    },
                    "server_errors": {
                      "type": "integer"
                    },
                    "routes": {
                      "type": "array",
                      "items": {
                        "type": "object"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/question-contract": {
      "get": {
        "summary": "Серверный контракт ответов 1–15",
        "responses": {
          "200": {
            "description": "Допустимые варианты ответов и ограничения выбора"
          }
        }
      }
    }
  },
