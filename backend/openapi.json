{
  "openapi": "3.0.3",
  "info": {
    "title": "AutoChoice API",
    "version": "3.0.0",
    "description": "Пропущенные вопросы можно опустить, передать null или skip. Все оценки — баллы модели. При пустой анкете возвращается статус needs_answers без рекомендаций."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "paths": {
    "/api/cars": {
      "get": {
        "summary": "Все комплектации и ссылки на фотографии",
        "responses": {
          "200": {
            "description": "Снимок SQLite",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "cars": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Car"
                      }
                    }
                  },
                  "required": [
                    "cars"
                  ]
                },
                "example": {
                  "cars": [
                    {
                      "body_type": "wagon",
                      "boot_l": 495,
                      "brand": "Audi",
                      "bright": 3.0,
                      "car_size": "medium",
                      "cargo": 3.6,
                      "city": 3.5,
                      "classic": 4.0,
                      "clearance_mm": 180,
                      "comfort": 4.5,
                      "condition": "used",
                      "cozy_interior": 4.5,
                      "crossover_style": 2.0,
                      "daily_use": 3.7,
                      "data_date": "2026-11-21",
                      "description": "Ориентировочные данные каталога.",
                      "drive": "4wd",
                      "driving_fun": 4.0,
                      "dynamics": 3.5,
                      "economy": 3.7,
                      "elegant": 4.5,
                      "engine_power_hp": 245,
                      "family": 3.7,
                      "fuel_consumption": 7.2,
                      "fuel_type": "petrol",
                      "futuristic": 2.0,
                      "gravel": 3.3,
                      "highway": 5.0,
                      "hybrid_type": null,
                      "id": "audi-a4-allroad",
                      "image": "audi-a4-allroad.jpg",
                      "image_url": "/cars/images/audi-a4-allroad.jpg",
                      "maintenance": 3.0,
                      "minimalist": 4.5,
                      "model": "A4 allroad",
                      "offroad": 2.2,
                      "price_rub": 3330000,
                      "quality": {
                        "hybrid_type": "not_applicable"
                      },
                      "reliability": null,
                      "safety": null,
                      "seats": 5,
                      "sedan_style": 1.0,
                      "source": "https://www.drom.ru/catalog/audi/a4_allroad_quattro/268236/",
                      "sport_style": 3.0,
                      "tech_interior": 3.5,
                      "transmission": "robot",
                      "trim": "2.0 45 TFSI quattro S Tronic",
                      "verified_at": "2026-11-21",
                      "year": 2020
                    }
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Каталог временно недоступен.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Каталог временно недоступен."
                }
              }
            }
          }
        }
      }
    },
    "/api/catalog/status": {
      "get": {
        "summary": "Результат последнего импорта",
        "responses": {
          "200": {
            "description": "Статус каталога",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "count": {
                      "type": "integer"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "empty",
                        "ready",
                        "error"
                      ]
                    },
                    "errors": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "warnings": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    }
                  },
                  "required": [
                    "count",
                    "status",
                    "errors",
                    "warnings"
                  ]
                },
                "example": {
                  "count": 100,
                  "status": "ready",
                  "errors": [],
                  "warnings": []
                }
              }
            }
          },
          "503": {
            "description": "Каталог временно недоступен.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Каталог временно недоступен."
                }
              }
            }
          }
        }
      }
    },
    "/api/recommend": {
      "post": {
        "summary": "Подобрать автомобили и объяснить результат",
        "responses": {
          "200": {
            "description": "Рейтинги, основные карточки и возможные изменения",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Result"
                },
                "example": {
                  "balance": [],
                  "compromises": [
                    {
                      "answers": {
                        "1": "custom",
                        "budgetMax": 250000
                      },
                      "count": 1,
                      "description": "Увеличить бюджет до 250 000 ₽"
                    }
                  ],
                  "count": 0,
                  "filterDetails": [
                    {
                      "label": "Цена до 1 ₽",
                      "question": 1,
                      "rejected": 100,
                      "unknown": 0
                    }
                  ],
                  "filters": [
                    "Цена до 1 ₽ — не подходят 100, недостаточно данных для 0."
                  ],
                  "heart": [],
                  "message": "В каталоге пока нет автомобилей, которые подтверждённо выполняют все условия.",
                  "notes": [],
                  "picks": [],
                  "reason": [],
                  "status": "no_matches",
                  "totalCatalog": 100,
                  "dna": {
                    "status": "preliminary",
                    "primary": null,
                    "description": "Ответь на большее число вопросов, чтобы получить профиль.",
                    "traits": [
                      {
                        "key": "practical",
                        "label": "Практичность",
                        "percent": 0
                      },
                      {
                        "key": "comfort",
                        "label": "Комфорт",
                        "percent": 0
                      },
                      {
                        "key": "economy",
                        "label": "Экономичность",
                        "percent": 0
                      },
                      {
                        "key": "dynamics",
                        "label": "Динамика",
                        "percent": 0
                      },
                      {
                        "key": "style",
                        "label": "Стиль",
                        "percent": 0
                      }
                    ]
                  }
                }
              }
            }
          },
          "400": {
            "description": "Проверьте ответы и попробуйте ещё раз.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Проверьте ответы и попробуйте ещё раз."
                }
              }
            }
          },
          "413": {
            "description": "Максимальный размер запроса — 16 КиБ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Максимальный размер запроса — 16 КиБ."
                }
              }
            }
          },
          "503": {
            "description": "Каталог временно недоступен.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Каталог временно недоступен."
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Request"
              },
              "example": {
                "answers": {
                  "1": "2to5",
                  "5": "five",
                  "7": [
                    "automatic"
                  ],
                  "11": "a"
                },
                "balance": 50
              }
            }
          }
        }
      }
    },
    "/cars/images/{name}": {
      "get": {
        "summary": "Локальная фотография по имени из каталога",
        "responses": {
          "200": {
            "description": "Байты изображения",
            "content": {
              "image/*": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Файл не найден",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "in": "path",
            "name": "name",
            "required": true,
            "schema": {
              "type": "string"
            },
            "example": "peugeot-traveller.jpg"
          }
        ]
      }
    },
    "/cars/catalog.csv": {
      "get": {
        "summary": "Скачать исходный CSV в UTF-8",
        "responses": {
          "200": {
            "description": "CSV-файл со строкой заголовков",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "404": {
            "description": "Файл не найден",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    },
