    "/api/duels": {
      "post": {
        "summary": "Подобрать визуальные примеры из каталога",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "answers": {
                    "$ref": "#/components/schemas/Answers"
                  }
                },
                "required": [
                  "answers"
                ]
              },
              "example": {
                "answers": {
                  "4": [
                    "family"
                  ],
                  "8": "large"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Пары фотографий по номеру вопроса. Для отсутствующих пар используются стандартные иллюстрации.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "duels": {
                      "type": "object",
                      "additionalProperties": {
                        "type": "object",
                        "properties": {
                          "a": {
                            "type": "string"
                          },
                          "b": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "a",
                          "b"
                        ]
                      }
                    }
                  },
                  "required": [
                    "duels"
                  ]
                },
                "example": {
                  "duels": {
                    "11": {
                      "a": "/cars/images/volvo-xc90.jpg",
                      "b": "/cars/images/kia-ev6.jpg"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Проверьте ответы и попробуйте ещё раз.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Проверьте ответы и попробуйте ещё раз."
                }
              }
            }
          },
          "413": {
            "description": "Максимальный размер запроса — 16 КиБ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Максимальный размер запроса — 16 КиБ."
                }
              }
            }
          },
          "503": {
            "description": "Каталог временно недоступен.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Каталог временно недоступен."
                }
              }
            }
          }
        }
      }
    },
    "/api/explain-car": {
      "post": {
        "summary": "Объяснить место выбранной машины в подборе",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ExplainCarRequest"
              },
              "example": {
                "car_id": "land-rover-defender",
                "answers": {
                  "1": "under2",
                  "5": "five"
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Совместимость, обязательные условия и место в рейтинге баланса",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExplainCarResult"
                }
              }
            }
          },
          "400": {
            "description": "Проверьте ответы и попробуйте ещё раз.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Проверьте ответы и попробуйте ещё раз."
                }
              }
            }
          },
          "413": {
            "description": "Максимальный размер запроса — 16 КиБ.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Максимальный размер запроса — 16 КиБ."
                }
              }
            }
          },
          "503": {
            "description": "Каталог временно недоступен.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Каталог временно недоступен."
                }
              }
            }
          },
          "404": {
            "description": "Модель не найдена в каталоге",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                },
                "example": {
                  "message": "Автомобиль не найден."
                }
              }
            }
          }
        }
      }
    },
    "/api/home-picks": {
      "get": {
        "summary": "Готовые сценарии на главной странице React",
        "tags": [
          "Catalog"
